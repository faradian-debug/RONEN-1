rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function myEmail() { return request.auth.token.email.lower(); }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    // A partner is someone whose verified Google email the owner listed in users/{uid}.members.
    function isPartner(uid) {
      return signedIn()
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/users/$(uid))
        && myEmail() in get(/databases/$(database)/documents/users/$(uid)).data.get('members', []);
    }

    match /users/{uid} {
      // The journal's settings: who it is shared with (members) and which shared journal
      // this user agreed to join (joined). Only the owner changes them.
      allow read: if isOwner(uid) || isPartner(uid);
      allow write: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['members', 'joined'])
        && request.resource.data.get('members', []).size() <= 20;

      // Clients and treatments: the owner and their partners read and write.
      match /{col}/{docId} {
        allow read, write: if (col == 'clients' || col == 'treatments') && (isOwner(uid) || isPartner(uid));
      }
    }

    // Lets a partner find the journals shared with them. Id: <ownerUid>_<email>.
    match /invites/{inviteId} {
      // A partner lists invites with where("email", "==", theirEmail); keep that rule a single
      // condition so Firestore can prove the query safe from its filter alone.
      allow list: if signedIn() && resource.data.email == myEmail();
      allow get: if signedIn() && (resource.data.ownerUid == request.auth.uid || resource.data.email == myEmail());
      // The inviter's uid and email come from their own sign-in, so an invite cannot pose as someone else.
      allow create, update: if signedIn()
        && request.resource.data.keys().hasOnly(['email', 'ownerUid', 'ownerName', 'ownerEmail'])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerEmail == myEmail()
        && request.resource.data.email == request.resource.data.email.lower()
        && request.resource.data.ownerName is string && request.resource.data.ownerName.size() <= 100
        && inviteId == request.auth.uid + '_' + request.resource.data.email;
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }
  }
}
